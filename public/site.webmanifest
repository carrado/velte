{
  "name": "Velte",
  "short_name": "Velte",
  "description": "Describe what you need and Velte finds it — real vendors near you, with prices, photos and a way to reach them.",
  "id": "/",
  "start_url": "/launch?source=pwa",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "categories": ["shopping", "business", "productivity"],
  "icons": [
    {
      "src": "/velte_manifest.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/velte_manifest.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/velte_manifest.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New search",
      "url": "/chat",
      "description": "Ask Velte to find something"
    },
    {
      "name": "Watching",
      "url": "/chat/watches",
      "description": "Prices Velte is watching for you"
    }
  ]
}
